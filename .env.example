# .env.example — EmpresTI (espelha ADR-001 §5, §7, §9, §10)
# Copie para .env.local e preencha. Nunca commite valores reais.
# Regra ADR §10: nada com prefixo NEXT_PUBLIC_ é segredo; tudo sem esse prefixo é somente-servidor.

# --- Prisma -> Supabase Postgres (§5 Dados e persistência) ---
# Runtime via Supavisor (pooler), porta 6543. Exige pgbouncer + connection_limit=1 (obrigatório em serverless/Vercel).
DATABASE_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migration via conexão direta, porta 5432. Usada pelo `prisma migrate deploy` no CI (§9).
DIRECT_URL="postgresql://postgres.[ref]:[SENHA]@db.[ref].supabase.co:5432/postgres"

# --- Supabase Auth via @supabase/ssr (§7 + §10) ---
# PÚBLICAS: vão para o bundle do cliente. Pegar em Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
# Publishable key (sb_publishable_...). Segura no browser pois o RLS limita o alcance.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# SOMENTE SERVIDOR: sem prefixo NEXT_PUBLIC_. Secret key (sb_secret_...) em Project Settings > API.
# IGNORA O RLS — nunca importe em Client Component, nunca exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Rastreamento de erro (§9 Hospedagem e operação) ---
# Sentry DSN: sentry.io > projeto Next.js > Settings > Client Keys (DSN).
SENTRY_DSN="https://...@....ingest.sentry.io/..."
